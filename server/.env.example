# Server Configuration
PORT=5000
NODE_ENV=development

# Authentication (REQUIRED - generate a strong random string)
JWT_SECRET=your_strong_random_secret_here

# Google OAuth (for Google Sign-In)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Use Web application type, add authorized origins
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Payment Gateways (set these to use payment features)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret
RAZORPAY_KEY_ID=rzp_test_your_razorpay_id
RAZORPAY_KEY_SECRET=rzp_test_your_razorpay_secret

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
